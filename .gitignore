.DS_Store
*.log

.config-backups/
.local/state/config-migration-backups/

# Stow links these folders into ~/.config, so the apps write into the repo.
# gh puts OAuth tokens in hosts.yml when it can't use the system keyring.
config/gh/*
!config/gh/config.yml
config/zed/*
!config/zed/settings.json
!config/zed/keymap.json
