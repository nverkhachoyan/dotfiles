// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "iloveyou",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/nverk/Dev/tuck"
          ]
        }
      ]
    }
  ],
  "format_on_save": "on",
  "redact_private_values": false,
  "accessible_mode": false,
  "which_key": {
    "enabled": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "show_menus": false
  },
  "status_bar": {
    "line_endings_button": false
  },
  "proxy": "",
  "collaboration_panel": {
    "button": false
  },
  "icon_theme": "VSCode Icons for Zed (Dark Angular)",
  "file_scan_exclusions":[
    // "**/*test*/**",
    //     "**/*test*",
    //     "**/*.test.*",
    //     "**/*.spec.*"
  ],
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "format_on_save": "on",
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "format_on_save": "on",
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "format_on_save": "on",
    },
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "thought_level": "high",
        "model": "openai-codex/gpt-5.6-sol"
      },
      "type": "registry",
    },
  },
  "show_edit_predictions": false,
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "threads_sidebar": {
      "position": "right"
    },
    "profiles": {
      "full-force": {
        "name": "full-force",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_profile": "write",
    "default_model": {
      "speed": "standard",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "high"
    },
    "button": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "code_actions_on_format": {
    "source.fixAll": true,
    "source.organizeImports": true,
  },
  "project_panel": {
    "button": true,
    "indent_guides": {
      "show": "always"
    },
    "hide_hidden": false,
    "hide_root": false,
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "entry_spacing": "comfortable",
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "vim_mode": true,
  "auto_install_extensions": {
    "one-dark-pro-max": true,
    "vscode-icons": true,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro Max",
  },
}
