# shellcheck shell=bash

[[ $- == *i* ]] || return

# The distro's stock ~/.bashrc did this before the stub replaced it. On Fedora,
# /etc/bashrc is what loads /etc/profile.d (completion, vte) in non-login shells.
# shellcheck source=/dev/null
[ -f /etc/bashrc ] && . /etc/bashrc

# shellcheck source=/dev/null
[ -f "$HOME/.config/shell/env.sh" ] && . "$HOME/.config/shell/env.sh"
# shellcheck source=/dev/null
[ -f "$HOME/.config/shell/aliases.sh" ] && . "$HOME/.config/shell/aliases.sh"

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
HISTFILESIZE=100000
HISTSIZE=10000

shopt -s histappend
shopt -s extglob
shopt -s globstar
shopt -s checkjobs

# starship replaces PROMPT_COMMAND, so the hooks below must be added after it.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

if [[ -n "${GHOSTTY_RESOURCES_DIR:-}" ]]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 && :$SHELLOPTS: =~ :(vi|emacs): ]]; then
  eval "$(fzf --bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
fi

bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\C-l": clear-screen'
