#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Report where the installed packages and the package lists in this repo
disagree. It only reports; it never installs or removes anything."""

import json
import os
import platform
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def run(*args: str, check: bool = True) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=check).stdout


def lines(text: str) -> set[str]:
    return {line.strip() for line in text.splitlines() if line.strip()}


def linux_distro() -> str:
    # scripts/lib/os.sh holds the distro rules, so ask it rather than copy them.
    lib = REPO_ROOT / "scripts/lib/os.sh"
    return run("bash", "-c", f'source "{lib}" && detect_linux_distro').strip()


def report(title: str, items: set[str] | list[str]) -> bool:
    if not items:
        return False
    print(f"\n{title}")
    for item in sorted(items):
        print(f"  {item}")
    return True


def mise_duplicates(owner) -> dict[str, set[str]]:
    """Packages from the OS package manager that install a command mise also
    provides, mapped to those commands. mise's shims come first in PATH, so
    these copies are unused."""
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    shims = data_home / "mise/shims"
    if not shims.is_dir():
        return {}

    duplicates: dict[str, set[str]] = {}
    for shim in shims.iterdir():
        package = owner(shim.name)
        if package:
            duplicates.setdefault(package, set()).add(shim.name)
    return duplicates


def report_duplicates(duplicates: dict[str, set[str]]) -> bool:
    return report(
        "Installed by the OS but also managed by mise "
        "(remove unless something depends on it):",
        [f"{pkg} ({cmd})" for pkg, cmds in duplicates.items() for cmd in cmds],
    )


def read_package_list(path: Path) -> set[str]:
    return {line.split("#", 1)[0].strip() for line in path.read_text().splitlines()} - {
        ""
    }


def fedora_user_installed() -> set[str]:
    """Names of packages installed with an explicit `dnf install` on this
    machine, skipping the ones the OS image came with. Those are transactions
    from before the root filesystem existed, recorded by the image build."""
    installed_after = int(run("stat", "-c", "%W", "/"))
    transactions = json.loads(run("dnf", "history", "list", "--json"))
    ids = [str(t["id"]) for t in transactions if t["start_time"] > installed_after]
    if not ids:
        return set()

    names = set()
    for transaction in json.loads(run("dnf", "history", "info", "--json", *ids)):
        for pkg in transaction["packages"]:
            if pkg["action"] == "Install" and pkg["reason"] == "User":
                # nevra is name-[epoch:]version-release.arch
                names.add(pkg["nevra"].rsplit("-", 2)[0])

    # Still installed, and still marked as installed by the user.
    user_installed = lines(
        run("dnf", "repoquery", "--userinstalled", "--qf", "%{name}\n")
    )
    return names & user_installed


def rpm_owner(command: str) -> str | None:
    path = Path("/usr/bin") / command
    if not path.exists():
        return None
    result = subprocess.run(
        ["rpm", "-qf", "--qf", "%{NAME}\n", str(path)],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def drift_fedora() -> bool:
    wanted = read_package_list(REPO_ROOT / "profiles/linux/fedora/packages.txt")
    installed = lines(run("rpm", "-qa", "--qf", "%{NAME}\n"))
    duplicates = mise_duplicates(rpm_owner)

    missing = wanted - installed
    extra = {
        name
        for name in fedora_user_installed() - wanted - duplicates.keys()
        if not name.startswith("kernel")
    }

    found = report(
        "In packages.txt but not installed (run scripts/install-packages-linux.sh):",
        missing,
    )
    found |= report(
        "Installed with dnf but not in packages.txt (add them or remove them):", extra
    )
    found |= report_duplicates(duplicates)
    return found


def drift_darwin() -> bool:
    brewfile = str(REPO_ROOT / "profiles/darwin/Brewfile")
    brew_bin = Path(run("brew", "--prefix").strip()) / "bin"

    def brew_owner(command: str) -> str | None:
        link = brew_bin / command
        if not link.is_symlink():
            return None
        # Links look like ../Cellar/<formula>/<version>/bin/<name>.
        parts = Path(os.readlink(link)).parts
        return parts[parts.index("Cellar") + 1] if "Cellar" in parts else None

    duplicates = mise_duplicates(brew_owner)

    check = run("brew", "bundle", "check", "--file", brewfile, "--verbose", check=False)
    missing = {line[2:] for line in check.splitlines() if line.startswith("→ ")}
    # Without --force, cleanup only lists what it would uninstall.
    cleanup = run("brew", "bundle", "cleanup", "--file", brewfile, check=False)
    extra = {
        line for line in lines(cleanup) if not line.startswith(("Would ", "Run "))
    } - duplicates.keys()

    found = report("In the Brewfile but not installed (run brew bundle):", missing)
    found |= report(
        "Installed with brew but not in the Brewfile (add them or remove them):", extra
    )
    found |= report_duplicates(duplicates)
    return found


def main() -> int:
    system = platform.system()
    if system == "Darwin":
        found = drift_darwin()
    elif system == "Linux":
        distro = linux_distro()
        if distro != "fedora":
            print(
                f"Drift is only checked on Fedora so far (this is {distro}).",
                file=sys.stderr,
            )
            return 0
        found = drift_fedora()
    else:
        print("Unsupported OS.", file=sys.stderr)
        return 1

    if not found:
        print("Installed packages match the package lists.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
