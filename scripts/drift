#!/usr/bin/env bash

set -euo pipefail

# Report where the installed packages and the package lists in this repo
# disagree. It only reports; it never installs or removes anything.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=scripts/lib/os.sh
source "$repo_root/scripts/lib/os.sh"

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT

drift=0

# Print a titled list from a file, or nothing if the file is empty.
report() {
  local title="$1" file="$2"

  [ -s "$file" ] || return 0
  drift=1
  printf '\n%s\n' "$title"
  sed 's/^/  /' "$file"
}

# Packages from the OS package manager that install a command mise also
# provides, as "package (command)". mise's shims come first in PATH, so these
# copies are unused.
mise_duplicates() {
  local owner_cmd="$1" shims_dir name owner

  shims_dir="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"
  [ -d "$shims_dir" ] || return 0

  for name in "$shims_dir"/*; do
    name="${name##*/}"
    owner="$("$owner_cmd" "$name")" || continue
    printf '%s (%s)\n' "$owner" "$name"
  done | LC_ALL=C sort -u
}

# Drop the packages listed in duplicates from a list of package names, so
# each package is reported once.
without_duplicates() {
  cut -d' ' -f1 "$work_dir/duplicates" | LC_ALL=C sort -u >"$work_dir/duplicate_names"
  LC_ALL=C comm -23 - "$work_dir/duplicate_names"
}

rpm_owner() {
  [ -e "/usr/bin/$1" ] && rpm -qf --qf '%{NAME}\n' "/usr/bin/$1" 2>/dev/null
}

brew_owner() {
  local link="$brew_prefix/bin/$1" target

  [ -L "$link" ] || return 1
  target="$(readlink "$link")"
  # Links look like ../Cellar/<formula>/<version>/bin/<name>.
  case "$target" in
    */Cellar/*) target="${target#*/Cellar/}" && printf '%s\n' "${target%%/*}" ;;
    *) return 1 ;;
  esac
}

# Names of packages installed with an explicit `dnf install` on this machine,
# skipping the ones the OS image came with. Those are transactions from before
# the root filesystem existed, recorded by the image build.
fedora_user_installed() {
  local installed_after

  installed_after="$(stat -c %W /)"
  dnf history list --json 2>/dev/null |
    python3 -c '
import json, subprocess, sys

after = int(sys.argv[1])
ids = [str(t["id"]) for t in json.load(sys.stdin) if t["start_time"] > after]
if not ids:
    sys.exit()
info = subprocess.run(
    ["dnf", "history", "info", "--json", *ids],
    capture_output=True, text=True, check=True,
).stdout
for transaction in json.loads(info):
    for pkg in transaction["packages"]:
        if pkg["action"] == "Install" and pkg["reason"] == "User":
            # nevra is name-[epoch:]version-release.arch
            print(pkg["nevra"].rsplit("-", 2)[0])
' "$installed_after" | LC_ALL=C sort -u >"$work_dir/history"

  # Still installed, and still marked as installed by the user.
  dnf repoquery --userinstalled --qf '%{name}\n' 2>/dev/null |
    LC_ALL=C sort -u >"$work_dir/userinstalled"
  LC_ALL=C comm -12 "$work_dir/history" "$work_dir/userinstalled"
}

drift_fedora() {
  local list="$repo_root/profiles/linux/fedora/packages.txt"

  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$list" |
    LC_ALL=C sort -u >"$work_dir/wanted"
  rpm -qa --qf '%{NAME}\n' | LC_ALL=C sort -u >"$work_dir/installed"
  fedora_user_installed >"$work_dir/user"
  mise_duplicates rpm_owner >"$work_dir/duplicates"

  LC_ALL=C comm -23 "$work_dir/wanted" "$work_dir/installed" >"$work_dir/missing"
  LC_ALL=C comm -13 "$work_dir/wanted" "$work_dir/user" |
    grep -v '^kernel' | without_duplicates >"$work_dir/extra" || true

  report 'In packages.txt but not installed (run scripts/install-packages-linux.sh):' \
    "$work_dir/missing"
  report 'Installed with dnf but not in packages.txt (add them or remove them):' \
    "$work_dir/extra"
  report 'Installed by the OS but also managed by mise (remove unless something depends on it):' \
    "$work_dir/duplicates"
}

drift_darwin() {
  local brewfile="$repo_root/profiles/darwin/Brewfile"

  brew_prefix="$(brew --prefix)"
  mise_duplicates brew_owner >"$work_dir/duplicates"

  # Without --force, cleanup only lists what it would uninstall.
  brew bundle check --file "$brewfile" --verbose 2>/dev/null |
    grep -E '^→ ' | sed 's/^→ //' >"$work_dir/missing" || true
  brew bundle cleanup --file "$brewfile" 2>/dev/null |
    grep -vE '^(Would|Run) ' | LC_ALL=C sort -u | without_duplicates \
    >"$work_dir/extra" || true

  report 'In the Brewfile but not installed (run brew bundle):' "$work_dir/missing"
  report 'Installed with brew but not in the Brewfile (add them or remove them):' \
    "$work_dir/extra"
  report 'Installed by the OS but also managed by mise (remove unless something depends on it):' \
    "$work_dir/duplicates"
}

case "$(detect_os)" in
  darwin)
    drift_darwin
    ;;
  linux)
    distro="$(detect_linux_distro)"
    if [ "$distro" != fedora ]; then
      printf 'Drift is only checked on Fedora so far (this is %s).\n' "$distro" >&2
      exit 0
    fi
    drift_fedora
    ;;
  *)
    printf 'Unsupported OS.\n' >&2
    exit 1
    ;;
esac

if [ "$drift" -eq 0 ]; then
  printf 'Installed packages match the package lists.\n'
fi
