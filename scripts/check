#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
check_home="$(mktemp -d)"
tmux_socket="dotfiles-check-$$"

cleanup() {
  tmux -L "$tmux_socket" kill-server 2>/dev/null || true
  rm -rf "$check_home"
}
trap cleanup EXIT

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Missing required check command: %s\n' "$1" >&2
    exit 1
  fi
}

require_command bash
require_command zsh
require_command shellcheck
require_command stow
require_command tmux

printf '%s\n' 'Checking shell syntax...'
bash -n "$repo_root"/scripts/*.sh "$repo_root"/scripts/lib/*.sh \
  "$repo_root"/config/shell/bashrc "$repo_root"/config/shell/profile
zsh -n "$repo_root"/config/shell/zprofile "$repo_root"/config/shell/zshrc
shellcheck -x "$repo_root"/scripts/*.sh "$repo_root"/scripts/lib/*.sh \
  "$repo_root"/config/shell/bashrc "$repo_root"/config/shell/profile \
  "$repo_root"/config/shell/*.sh "$repo_root"/config/shell/env.d/*.sh

printf '%s\n' 'Checking secrets stay ignored...'
if ! git -C "$repo_root" check-ignore -q config/gh/hosts.yml; then
  printf '%s\n' 'config/gh/hosts.yml must be gitignored (it can hold OAuth tokens).' >&2
  exit 1
fi
if git -C "$repo_root" check-ignore -q config/gh/config.yml; then
  printf '%s\n' 'config/gh/config.yml is gitignored but should be tracked.' >&2
  exit 1
fi

printf '%s\n' 'Checking tmux configuration...'
HOME="$check_home" tmux -f "$repo_root/config/tmux/tmux.conf" -L "$tmux_socket" start-server

printf '%s\n' 'Checking isolated config linking...'
link_configs() {
  HOME="$check_home" XDG_CONFIG_HOME="$check_home/.config" \
    "$repo_root/scripts/link-configs.sh" >/dev/null
}

# A startup file left linked into the repo by an older setup.
ln -s "$repo_root/home/.zshrc" "$check_home/.zshrc"
link_configs

test -L "$check_home/.config/nvim"
test ! -e "$check_home/.config/zsh"
for name in profile bashrc zprofile zshrc; do
  stub="$check_home/.$name"
  test -f "$stub"
  test ! -L "$stub"
  grep -qF "/.config/shell/$name\"" "$stub"
done
test ! -e "$check_home/.zshrc.bak"

# Lines an installer appends survive another run.
printf '%s\n' 'export INSTALLER_LINE=1' >>"$check_home/.zshrc"
link_configs
grep -qxF 'export INSTALLER_LINE=1' "$check_home/.zshrc"
test -L "$check_home/.gitconfig"
test -L "$check_home/.ssh/config"
test ! -e "$check_home/.bash_profile"
test ! -e "$check_home/.zshenv"
test -L "$check_home/.config/alacritty"
test -f "$check_home/.config/alacritty/alacritty.toml"
test -f "$check_home/.config/alacritty/themes/codex-noir.toml"
test ! -e "$check_home/.config/alacritty/color.toml"
test -f "$check_home/.config/mise/config.toml"

printf '%s\n' 'All checks passed.'
