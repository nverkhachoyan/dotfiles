#!/usr/bin/env bash

set -euo pipefail

# Update everything this repo installs. Pass sections to run only some of
# them: system, tools, nvim. With none, all run. -y/--yes answers the package
# managers' prompts; it's on by default when there is no terminal to ask on.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=scripts/lib/os.sh
source "$repo_root/scripts/lib/os.sh"

usage() {
  printf 'Usage: %s [-y|--yes] [system] [tools] [nvim]\n' "${0##*/}" >&2
  exit 2
}

assume_yes=0
[ -t 0 ] || assume_yes=1

sections=()
for arg in "$@"; do
  case "$arg" in
    -y | --yes) assume_yes=1 ;;
    system | tools | nvim) sections+=("$arg") ;;
    *) usage ;;
  esac
done
[ "${#sections[@]}" -gt 0 ] || sections=(system tools nvim)

yes_flag=()
[ "$assume_yes" -eq 0 ] || yes_flag=(-y)

step() {
  printf '\n==> %s\n' "$1"
}

update_system() {
  case "$(detect_os)" in
    darwin)
      step 'Homebrew'
      brew update
      brew upgrade
      # Also installs anything added to the Brewfile since the last run.
      brew bundle --file "$repo_root/profiles/darwin/Brewfile"
      ;;
    linux)
      step 'System packages'
      case "$(detect_linux_distro)" in
        fedora) sudo dnf upgrade --refresh "${yes_flag[@]}" ;;
        arch)
          if [ "$assume_yes" -eq 1 ]; then
            sudo pacman -Syu --noconfirm
          else
            sudo pacman -Syu
          fi
          ;;
        debian) sudo apt-get update && sudo apt-get upgrade "${yes_flag[@]}" ;;
        *) printf 'No package manager known for this distro, skipping.\n' ;;
      esac
      # Also installs anything added to packages.txt since the last run.
      "$repo_root/scripts/install-packages-linux.sh"

      if command -v flatpak >/dev/null 2>&1; then
        step 'Flatpak'
        if [ "$assume_yes" -eq 1 ]; then
          flatpak update -y --noninteractive
        else
          flatpak update
        fi
      fi
      ;;
  esac
}

update_tools() {
  step 'mise tools'
  # Moves every tool to the newest version its config.toml entry allows and
  # rewrites mise.lock. This includes Rust stable.
  mise upgrade --global
  # Fill in lockfile entries for the other platforms in lockfile_platforms.
  mise lock --global
  # Remove versions no tracked config needs any more. `upgrade --prune` leaves
  # them behind; prune also keeps any version that is still running.
  mise prune --tools --yes
}

update_nvim() {
  step 'Neovim plugins'
  # Updates lazy-lock.json in the repo; the plugin build steps run too
  # (nvim-treesitter's :TSUpdate).
  nvim --headless '+Lazy! sync' +qa
}

for section in "${sections[@]}"; do
  "update_$section"
done

step 'Lockfile changes to review and commit'
git -C "$repo_root" status --short -- config/mise config/nvim/lazy-lock.json
